# Settings for map_documents.py (Part B). Copy to .env, fill in, chmod 600. .env is git-ignored.
# The same names as the database migration's .env.

# The Gen1 farmer profile (Odoo) database, libpq form. Only read: best with a read-only user.
SOURCE_DSN=host=ODOO_DB_HOST port=5432 dbname=ODOO_DB_NAME user=READONLY_USER password=CHANGE_ME

# The Gen2 registry database (after the database migration has run).
TARGET_DSN=postgresql+psycopg2://REGISTRY_DB_USER:CHANGE_ME@REGISTRY_DB_HOST:5432/REGISTRY_DB_NAME

# Optional
# RCLONE_CONF=./rclone.conf     the MinIO and Garage keys come from its [old] and [garage] remotes
# BUCKET=documents
# LOG_DIR=./logs
# WORKERS=16                    parallel object checks

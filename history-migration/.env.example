# Settings for migrate_history.py. Copy to .env, fill in, chmod 600. .env is git-ignored.
# SOURCE_DSN and TARGET_DSN are the same as the database migration's .env.

# The Gen1 farmer profile (Odoo) database, libpq form. Only read: users and update requests.
SOURCE_DSN=host=ODOO_DB_HOST port=5432 dbname=ODOO_DB_NAME user=READONLY_USER password=CHANGE_ME

# The Gen1 audit database (Odoo's log_db.db.* system parameters, or G2P_CHANGE_LOG_DB_*), libpq form. Only read.
AUDIT_DSN=host=AUDIT_DB_HOST port=5432 dbname=audit_logs user=READONLY_USER password=CHANGE_ME

# The Gen2 registry database (after the database migration has run).
TARGET_DSN=postgresql+psycopg2://REGISTRY_DB_USER:CHANGE_ME@REGISTRY_DB_HOST:5432/REGISTRY_DB_NAME

# Optional
# HISTORY_SOURCE=PARTNER    change_request_source of the version 1 rows
# BATCH=1000                rows per transaction
# LOG_DIR=./logs

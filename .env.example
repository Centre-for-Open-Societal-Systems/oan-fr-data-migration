# Settings for the farmer profile -> Farmer registry migration.
# Copy to .env and fill in, one NAME=value per line, no quotes. .env is not committed.
#
#   locally:        ./run.sh dry-run | migrate | sql | apply | verify   (run.sh reads .env)
#   from the image: docker run --env-file .env -v "$PWD/out:/out" <image> migrate.py --all --dry-run
#   Kubernetes:     the same names, from a secret (deploy/job.yaml)

# -- Farmer profile (Odoo), read only. libpq form. Best with a read-only user.
SOURCE_DSN=host=ODOO_DB_HOST port=5432 dbname=ODOO_DB_NAME user=READONLY_USER password=CHANGE_ME

# -- The Farmer registry's database. SQLAlchemy form.
TARGET_DSN=postgresql+psycopg2://REGISTRY_DB_USER:CHANGE_ME@REGISTRY_DB_HOST:5432/REGISTRY_DB_NAME

# -- The Master Data Service the registry uses: only codes and locations it has are migrated.
# The registry chart's global.masterDataApiUrl, global.masterDataTokenUrl and global.authClientId,
# and that client's secret. A run without MDS_API_URL refuses to start (unless --pack-only).
MDS_API_URL=http://commons-services-master-data-api
MDS_TOKEN_URL=https://KEYCLOAK_HOST/realms/REALM/protocol/openid-connect/token
MDS_CLIENT_ID=REGISTRY_CLIENT_ID
MDS_CLIENT_SECRET=CHANGE_ME

# -- Optional
# The extension module of the registry (set in the registry's image already).
# REGISTRY_EXTENSION_MODULE=openg2p_registry_farmer_extension
# Where the run folders go (the image uses /out; mount a volume there).
# REPORT_DIR=/out

# -- Local runs only (run.sh, dev/*.sh); ignored by the image
# Leave SOURCE_DSN and TARGET_DSN unset to use the local containers: the farmer profile
# copy in fp-db (database SOURCE_DB) and the registry from dev/target-db.sh.
# A host given here must be reachable from a container on the fr-migration network.
# SOURCE_CONTAINER=fp-db
# SOURCE_DB=odk_a
# The registry to run on: a registry staff-api image, or a farmer-registry checkout.
# REGISTRY_IMAGE=
# REGISTRY_REPO=~/farmer-registry-develop
# PACK_DIR=~/openg2p-data
# Local Master Data stand-in (dev/fake-mds.sh):
# MDS_API_URL=http://fr-migration-mds:8000
